# OpenAI API Key for Embeddings and LLMs
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant Vector Database
# For local Qdrant container: http://localhost:6333
# For Qdrant Cloud: https://xxxxxx-xxxx.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_if_applicable
QDRANT_COLLECTION_NAME=personal_profile

# LangSmith Observability & Tracing (Free tier available)
# Sign up at https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-backend

# FastAPI Application Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
